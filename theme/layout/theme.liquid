<!doctype html>
<html lang="{{ request.locale.iso_code }}" class="no-js">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_bg }}">
    <script>document.documentElement.className = document.documentElement.className.replace('no-js', 'js');</script>
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64, height: 64 }}">
      <link rel="apple-touch-icon" href="{{ settings.favicon | image_url: width: 180, height: 180 }}">
    {%- else -%}
      <link rel="icon" type="image/svg+xml" href="{{ 'favicon.svg' | asset_url }}">
      <link rel="icon" type="image/png" sizes="32x32" href="{{ 'favicon-32.png' | asset_url }}">
      <link rel="apple-touch-icon" sizes="180x180" href="{{ 'apple-touch-icon.png' | asset_url }}">
    {%- endif -%}

    {%- liquid
      assign brand = settings.site_title | default: shop.name
      if request.page_type == 'index' or page_title == shop.name
        assign doc_title = brand
      elsif page_title contains brand
        assign doc_title = page_title
      elsif page_title contains shop.name
        assign doc_title = page_title | replace: shop.name, brand
      else
        assign doc_title = page_title | append: ' – ' | append: brand
      endif
    -%}
    <title>
      {{- doc_title -}}
      {%- if current_tags %} – {{ current_tags | join: ', ' }}{% endif -%}
      {%- if current_page > 1 %} – {{ 'general.page' | t }} {{ current_page }}{% endif -%}
    </title>
    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}

    {% render 'meta-tags' %}
    {% render 'theme-styles' %}

    {{ 'base.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'theme.js' | asset_url }}" defer></script>

    {{ content_for_header }}
  </head>

  <body class="template-{{ template.name | handle }}{% if settings.scroll_reveal %} reveal-on{% endif %}">
    <a class="skip-link" href="#main">{{ 'general.skip' | t }}</a>

    {% sections 'header-group' %}

    <main id="main" class="main" role="main">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {% render 'player' %}
    {% section 'cart-drawer' %}

    <script>
      window.CB = {
        routes: {
          cart: {{ routes.cart_url | json }},
          cartAdd: {{ routes.cart_add_url | json }},
          cartChange: {{ routes.cart_change_url | json }},
          root: {{ routes.root_url | json }}
        },
        cartType: {{ settings.cart_type | json }},
        strings: { playerError: {{ 'player.error' | t | json }} }
      };
    </script>
  </body>
</html>
