<footer class="footer{% unless section.settings.animate %} footer--static{% endunless %}" data-footer>
  <div class="footer__mark">
    <div class="fmk-inner" data-trail>
      <div class="fmk-wrap"><div class="fmk-word" data-fmk>{% render 'contra-wordmark', uid: 'foot', tag: false, class: 'cb-contra' %}</div></div>
      {%- for block in section.blocks -%}
        {%- if block.settings.image != blank -%}
          {{ block.settings.image | image_url: width: 400 | image_tag: class: 'fmk-img', loading: 'lazy', alt: '' }}
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>

  {%- if section.settings.newsletter -%}
    <div class="footer__nl">
      <div class="footer__nl-inner">
        <span class="label">{{ 'newsletter.label' | t }}</span>
        <p class="big">{{ section.settings.nl_heading }}</p>
        {%- form 'customer', class: 'line-input' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <label class="visually-hidden" for="nl-email">{{ 'general.email' | t }}</label>
          <input id="nl-email" type="email" name="contact[email]" placeholder="{{ 'general.email_address' | t }}" required autocomplete="email">
          <button type="submit" aria-label="{{ 'newsletter.submit' | t }}">↳</button>
        {%- endform -%}
      </div>
    </div>
  {%- endif -%}

  {%- liquid
    assign legal_keys = 'policies,impressum,datenschutz,agb,widerruf,legal' | split: ','
  -%}
  <div class="footer__bar">
    <div class="footer__cols">
      {%- capture info_links -%}{%- for link in section.settings.legal_menu.links -%}{%- assign is_legal = false -%}{%- for k in legal_keys -%}{%- if link.url contains k -%}{%- assign is_legal = true -%}{%- endif -%}{%- endfor -%}{%- unless is_legal -%}<li><a href="{{ link.url }}">{{ link.title }}</a></li>{%- endunless -%}{%- endfor -%}{%- endcapture -%}
      {%- capture legal_links -%}{%- for link in section.settings.legal_menu.links -%}{%- assign is_legal = false -%}{%- for k in legal_keys -%}{%- if link.url contains k -%}{%- assign is_legal = true -%}{%- endif -%}{%- endfor -%}{%- if is_legal -%}<li><a href="{{ link.url }}">{{ link.title }}</a></li>{%- endif -%}{%- endfor -%}{%- endcapture -%}
      {%- capture social_links -%}
        {%- if settings.social_instagram != blank -%}<li><a href="{{ settings.social_instagram }}" target="_blank" rel="noopener">Instagram</a></li>{%- endif -%}
        {%- if settings.social_tiktok != blank -%}<li><a href="{{ settings.social_tiktok }}" target="_blank" rel="noopener">TikTok</a></li>{%- endif -%}
        {%- if settings.social_youtube != blank -%}<li><a href="{{ settings.social_youtube }}" target="_blank" rel="noopener">YouTube</a></li>{%- endif -%}
        {%- if settings.social_spotify != blank -%}<li><a href="{{ settings.social_spotify }}" target="_blank" rel="noopener">Spotify</a></li>{%- endif -%}
      {%- endcapture -%}

      {%- if info_links != blank -%}<nav class="footer__col" aria-label="{{ section.settings.col_info | escape }}"><p class="footer__label">{{ section.settings.col_info }}</p><ul>{{ info_links }}</ul></nav>{%- endif -%}
      {%- if legal_links != blank -%}<nav class="footer__col" aria-label="{{ section.settings.col_legal | escape }}"><p class="footer__label">{{ section.settings.col_legal }}</p><ul>{{ legal_links }}</ul></nav>{%- endif -%}
      {%- if social_links != blank -%}<nav class="footer__col" aria-label="{{ section.settings.col_social | escape }}"><p class="footer__label">{{ section.settings.col_social }}</p><ul>{{ social_links }}</ul></nav>{%- endif -%}
      {%- if section.settings.studio_name != blank -%}
        <nav class="footer__col" aria-label="{{ section.settings.studio_label | default: section.settings.studio_name | escape }}">
          <p class="footer__label">{{ section.settings.studio_label }}</p>
          <ul>
            <li><a href="{{ section.settings.studio_url }}" target="_blank" rel="noopener">{{ section.settings.studio_name }}</a></li>
            {%- if section.settings.studio_instagram != blank -%}<li><a href="{{ section.settings.studio_instagram }}" target="_blank" rel="noopener">{{ section.settings.studio_instagram_label | default: 'Instagram' }}</a></li>{%- endif -%}
          </ul>
        </nav>
      {%- endif -%}
    </div>
    <div class="footer__base">
      <span class="footer__copy">© {{ shop.name }} {{ 'now' | date: '%Y' }}</span>
      {%- if section.settings.show_localization -%}{% render 'localization', style: 'full', form_id: 'loc-footer' %}{%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "checkbox", "id": "animate", "label": "CONTRA fährt beim Scrollen von oben ein", "default": true },
    { "type": "link_list", "id": "legal_menu", "label": "Links in der Fußleiste", "default": "footer" },
    { "type": "header", "content": "Spalten" },
    { "type": "paragraph", "content": "Links aus dem Footer-Menü werden automatisch sortiert: Impressum, Datenschutz, AGB und Widerruf landen unter „Rechtliches“, alles andere unter „Info“." },
    { "type": "text", "id": "col_info", "label": "Label Info", "default": "Info" },
    { "type": "text", "id": "col_legal", "label": "Label Rechtliches", "default": "Rechtliches" },
    { "type": "text", "id": "col_social", "label": "Label Social", "default": "Social" },
    { "type": "header", "content": "Studio" },
    { "type": "text", "id": "studio_label", "label": "Label", "default": "Studio" },
    { "type": "text", "id": "studio_name", "label": "Name", "info": "Leer = ausblenden.", "default": "LUX Studio" },
    { "type": "url", "id": "studio_url", "label": "Website" },
    { "type": "url", "id": "studio_instagram", "label": "Instagram" },
    { "type": "text", "id": "studio_instagram_label", "label": "Instagram-Text", "default": "@luxstudio030" },
    { "type": "checkbox", "id": "show_localization", "label": "Sprache und Land/Währung zeigen", "default": true },
    { "type": "checkbox", "id": "newsletter", "label": "Newsletter zeigen", "default": false },
    { "type": "text", "id": "nl_heading", "label": "Newsletter-Text", "default": "Neue Drops zuerst." }
  ],
  "blocks": [
    { "type": "image", "name": "Trail-Bild", "limit": 12, "settings": [
      { "type": "image_picker", "id": "image", "label": "Bild", "info": "Folgt der Maus über der Wortmarke (Hochformat 3:4)." }
    ] }
  ]
}
{% endschema %}
