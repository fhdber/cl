{%- liquid
  assign coll = section.settings.collection | default: collections.all
  assign limit = section.settings.limit
-%}
<section class="section{% if section.settings.rule %} section--rule{% endif %}">
  <div class="wrap">
    <div class="head">
      <h2 class="h2 head__title">{{ section.settings.heading | default: coll.title }}</h2>
      <a class="mono link-arrow" href="{{ coll.url }}">{{ section.settings.link_label }}</a>
    </div>
    {%- if coll.products_count > 0 -%}
      <div class="grid grid--4">
        {%- for product in coll.products limit: limit -%}
          {% render 'product-card', product: product, reveal: true %}
        {%- endfor -%}
      </div>
    {%- else -%}
      <p class="mono muted">Noch keine Produkte in dieser Kollektion.</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Produkt-Raster",
  "settings": [
    { "type": "text", "id": "heading", "label": "Headline", "default": "Neu im Shop" },
    { "type": "collection", "id": "collection", "label": "Kollektion" },
    { "type": "range", "id": "limit", "label": "Anzahl", "min": 2, "max": 16, "step": 1, "default": 8 },
    { "type": "text", "id": "link_label", "label": "Link-Text", "default": "Alle ansehen" },
    { "type": "checkbox", "id": "rule", "label": "Trennlinie oben", "default": false }
  ],
  "presets": [ { "name": "Produkt-Raster" } ]
}
{% endschema %}
