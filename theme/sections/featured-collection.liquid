{%- liquid
  assign coll = section.settings.collection | default: collections.all
-%}
<section class="{% if section.settings.style == 'edge' %}edge-sec{% else %}sec wrap{% endif %}" id="{{ section.id }}">
  <div class="head{% if section.settings.style == 'edge' %} head--edge{% endif %}">
    <span class="label">{{ section.settings.heading | default: coll.title }}</span>
    {%- if section.settings.link_label != blank -%}<a class="link" href="{{ coll.url }}">{{ section.settings.link_label }}</a>{%- endif -%}
  </div>
  {%- if coll.products_count > 0 -%}
    {%- if section.settings.style == 'edge' -%}
      <div class="edge-grid" style="--cols: {{ section.settings.columns }}">
        {%- for product in coll.products limit: section.settings.limit -%}
          {% render 'product-tile', product: product %}
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="grid" style="--cols: {{ section.settings.columns }}">
        {%- for product in coll.products limit: section.settings.limit -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      </div>
    {%- endif -%}
  {%- else -%}
    <p class="meta">{{ 'collection.no_products' | t }}</p>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Produkt-Raster",
  "settings": [
    { "type": "select", "id": "style", "label": "Stil", "default": "classic", "options": [
      { "value": "classic", "label": "Karten mit Titel und Meta (Layout)" },
      { "value": "edge", "label": "Randlos, enge Fugen, Infos beim Hover" }
    ] },
    { "type": "text", "id": "heading", "label": "Label", "default": "Neueste Drops" },
    { "type": "collection", "id": "collection", "label": "Kollektion" },
    { "type": "range", "id": "limit", "label": "Anzahl", "min": 2, "max": 24, "step": 1, "default": 3 },
    { "type": "range", "id": "columns", "label": "Spalten Desktop", "min": 2, "max": 5, "step": 1, "default": 3 },
    { "type": "text", "id": "link_label", "label": "Link-Text", "default": "Alle ansehen ↳" }
  ],
  "presets": [ { "name": "Produkt-Raster" } ]
}
{% endschema %}
