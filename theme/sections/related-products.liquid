{%- liquid
  assign shown = 0
-%}
<section class="sec wrap">
  <div>
    <div class="head">
      <span class="label">{{ section.settings.heading }}</span>
      <a class="link" href="{{ routes.all_products_collection_url }}">Alle Kits</a>
    </div>
    <div class="grid" style="--cols: 3">
      {%- for p in collections.all.products -%}
        {%- if p.id != product.id and shown < 3 -%}
          {%- if p.type == product.type or section.settings.any_type -%}
            {% render 'product-card', product: p %}
            {%- assign shown = shown | plus: 1 -%}
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
      {%- if shown < 3 -%}
        {%- for p in collections.all.products -%}
          {%- if p.id != product.id and p.type != product.type and shown < 3 -%}
            {% render 'product-card', product: p %}
            {%- assign shown = shown | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Ähnliche Kits",
  "settings": [
    { "type": "text", "id": "heading", "label": "Headline", "default": "Passt dazu" },
    { "type": "checkbox", "id": "any_type", "label": "Alle Typen mischen", "default": false }
  ]
}
{% endschema %}
