{%- liquid
  assign current = product.selected_or_first_available_variant
  assign m = product.metafields.specs
  assign catalog = m.catalog_number.value
  assign demo = m.demo.value
  assign previews = m.previews.value
-%}
<div class="wrap">
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href="{{ routes.all_products_collection_url }}">Shop</a><span>/</span>
    {%- if collection -%}<a href="{{ collection.url }}">{{ collection.title }}</a><span>/</span>{%- elsif product.type != blank -%}<span>{{ product.type }}</span><span>/</span>{%- endif -%}
    <span aria-current="page">{{ product.title }}</span>
  </nav>

  <div class="product">
    <div class="product__media" data-gallery>
      <div class="card__media" data-gallery-main>
        {%- if product.featured_media -%}
          {% render 'cover', product: product, image: product.featured_media.preview_image, sizes: '(min-width: 1024px) 56vw, 100vw', loading: 'eager' %}
        {%- else -%}
          {% render 'cover', product: product %}
        {%- endif -%}
        {% render 'play-button', product: product %}
      </div>
      {%- if product.media.size > 1 -%}
        <div class="product__thumbs">
          {%- for media in product.media limit: 5 -%}
            {%- assign img = media.preview_image -%}
            <button type="button" data-gallery-thumb aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
              data-src="{{ img | image_url: width: 1600 }}"
              data-srcset="{{ img | image_url: width: 720 }} 720w, {{ img | image_url: width: 1200 }} 1200w, {{ img | image_url: width: 1600 }} 1600w"
              data-alt="{{ img.alt | escape }}" aria-label="{{ 'product.image' | t }} {{ forloop.index }}">
              {{ img | image_url: width: 200 | image_tag: loading: 'lazy', alt: '' }}
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <div class="product__info">
      <div>
        <span class="label">{% if catalog %}{{ catalog }} · {% endif %}{{ product.type | default: 'Sample Pack' }}</span>
        <h1 class="product__title">{{ product.title }}</h1>
        {% render 'meta-line', product: product %}
        <p class="product__price" style="margin-top:8px"><span data-price>{% render 'price', product: product, variant: current %}</span>{% if product.price_max > 0 %} <span class="meta product__vat">{{ 'cart.vat' | t }}</span>{% endif %}</p>
      </div>

      {%- if demo != blank -%}
        <div class="product__demo">
          {% render 'play-button', product: product, src: demo.url, label: section.settings.demo_label %}
          <div>
            <p class="product__demo-title">{{ section.settings.demo_label }}</p>
            <p class="meta">{{ section.settings.demo_hint }}</p>
          </div>
        </div>
      {%- endif -%}

      {%- form 'product', product, class: 'product__buy', data-product-form: '' -%}
        {%- if product.has_only_default_variant -%}
          <input type="hidden" name="id" value="{{ current.id }}">
        {%- else -%}
          <fieldset class="variants">
            <legend class="label">{{ product.options.first }}</legend>
            {%- for variant in product.variants -%}
              {%- capture vp -%}{% render 'price', product: product, variant: variant %}{%- endcapture -%}
              <input type="radio" name="id" id="v-{{ variant.id }}" value="{{ variant.id }}"
                {% if variant == current %}checked{% endif %}
                data-available="{{ variant.available }}" data-price="{{ vp | escape }}">
              <label for="v-{{ variant.id }}">{{ variant.title }}</label>
            {%- endfor -%}
          </fieldset>
        {%- endif -%}
        <input type="hidden" name="quantity" value="1">
        <button type="submit" class="btn btn--block" {% unless current.available %}disabled{% endunless %}>
          <span class="btn__label" data-add="{% if product.price == 0 %}{{ 'product.add_free' | t }}{% else %}{{ 'product.add' | t }}{% endif %}" data-soldout="{{ 'product.soldout' | t }}">
            {%- if current.available -%}{% if current.price == 0 %}{{ 'product.add_free' | t }}{% else %}{{ 'product.add' | t }}{% endif %}{%- else -%}{{ 'product.soldout' | t }}{%- endif -%}
          </span>
        </button>
        <p class="meta">{{ section.settings.delivery_note }}</p>
        {%- if section.settings.show_exclusive -%}
          {%- liquid
            assign ex_subject = 'Exklusiv-Anfrage: ' | append: product.title | url_encode
            assign ex_url = section.settings.exclusive_link
            if ex_url == blank
              assign ex_url = 'mailto:' | append: shop.email | append: '?subject=' | append: ex_subject
            endif
          -%}
          <p class="meta product__ex">{{ section.settings.exclusive_text }} <a class="ul" href="{{ ex_url }}">{{ 'license.exclusive' | t }}</a> · <a class="ul" href="#lizenzen">{{ 'license.compare' | t }}</a></p>
        {%- endif -%}
      {%- endform -%}

      {%- if section.settings.highlights != blank -%}
        {%- assign hl = section.settings.highlights | newline_to_br | split: '<br />' -%}
        <ul class="checks">
          {%- for h in hl -%}{%- assign h = h | strip -%}{%- if h != blank -%}<li>{{ h }}</li>{%- endif -%}{%- endfor -%}
        </ul>
      {%- endif -%}

      {%- if m.contents.value != blank -%}
        {%- assign lines = m.contents.value | newline_to_br | split: '<br />' -%}
        <div style="display:grid;gap:12px">
          <h2 class="label">{{ 'product.contents' | t }}</h2>
          <div class="contents">
            {%- for l in lines -%}
              {%- assign l = l | strip -%}
              {%- if l != blank -%}
                {%- assign num = l | split: ' ' | first -%}
                <div><strong>{{ num }}</strong><span class="meta">{{ l | remove_first: num | strip }}</span></div>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}

      <dl class="specs">
        {%- if m.sample_count.value -%}<div><dt>Samples</dt><dd>{{ m.sample_count.value }}</dd></div>{%- endif -%}
        {%- if m.format.value -%}<div><dt>Format</dt><dd>{{ m.format.value }}</dd></div>{%- endif -%}
        {%- if m.bpm.value -%}<div><dt>BPM</dt><dd>{{ m.bpm.value }}</dd></div>{%- endif -%}
        {%- if m.key.value -%}<div><dt>Key</dt><dd>{{ m.key.value }}</dd></div>{%- endif -%}
        {%- if m.genre.value -%}<div><dt>Genre</dt><dd>{{ m.genre.value | join: ', ' }}</dd></div>{%- endif -%}
        {%- if m.daw.value -%}<div><dt>DAW</dt><dd>{{ m.daw.value }}</dd></div>{%- endif -%}
        {%- if m.file_size.value -%}<div><dt>{{ 'product.size' | t }}</dt><dd>{{ m.file_size.value }}</dd></div>{%- endif -%}
        <div><dt>{{ 'product.license' | t }}</dt><dd>{{ section.settings.license_spec | default: 'Royalty-free' }}</dd></div>
      </dl>

      {%- liquid
        assign yt = m.video.value | default: m.video
        assign yt_id = ''
        if yt != blank
          assign yt_s = yt | append: ''
          if yt_s contains 'youtu.be/'
            assign yt_id = yt_s | split: 'youtu.be/' | last | split: '?' | first
          elsif yt_s contains 'v='
            assign yt_id = yt_s | split: 'v=' | last | split: '&' | first
          elsif yt_s contains '/shorts/'
            assign yt_id = yt_s | split: '/shorts/' | last | split: '?' | first
          elsif yt_s contains '/embed/'
            assign yt_id = yt_s | split: '/embed/' | last | split: '?' | first
          endif
        endif
      -%}
      {%- if yt_id != blank -%}
        <div class="yt" data-yt="{{ yt_id | escape }}">
          <button type="button" class="yt__btn" aria-label="{{ 'product.video_play' | t }}">
            {%- if product.featured_media -%}{{ product.featured_media.preview_image | image_url: width: 960 | image_tag: loading: 'lazy', alt: '' }}{%- endif -%}
            <span class="yt__play">{% render 'icon', icon: 'play' %}</span>
          </button>
          <p class="meta yt__note">{{ 'product.video_consent' | t }}</p>
        </div>
      {%- endif -%}

      {%- if previews != blank -%}
        <div style="display:grid;gap:12px">
          <h2 class="label">Previews</h2>
          <ol class="tracks">
            {%- for file in previews -%}
              {%- liquid
                assign fname = file.url | split: '/' | last | split: '?' | first
                assign ext = fname | split: '.' | last
                assign label = fname | remove: ext | remove_last: '.' | replace: '_', ' ' | replace: '-', ' '
                if file.alt != blank
                  assign label = file.alt
                endif
              -%}
              <li>
                <button type="button" class="track" data-play data-src="{{ file.url }}" data-title="{{ label | escape }}" data-sub="{{ product.title | escape }}"
                  data-cover="{% if product.featured_media %}{{ product.featured_media.preview_image | image_url: width: 120 }}{% endif %}" data-url="{{ product.url }}">
                  <span class="track__num"></span>
                  <span>{{ label }}</span>
                  <span class="track__icon">{% render 'icon', icon: 'play' %}{% render 'icon', icon: 'pause' %}</span>
                </button>
              </li>
            {%- endfor -%}
          </ol>
        </div>
      {%- endif -%}

      <div>
        {%- if product.description != blank -%}
          <details class="details" open>
            <summary>{{ 'product.description' | t }}</summary>
            <div class="details__body rte">{{ product.description }}</div>
          </details>
        {%- endif -%}
        <details class="details">
          <summary>{{ 'product.license' | t }}</summary>
          <div class="details__body rte">{{ section.settings.license_text }}</div>
        </details>
        <details class="details">
          <summary>{{ 'product.download' | t }}</summary>
          <div class="details__body rte">{{ section.settings.download_text }}</div>
        </details>
      </div>
    </div>
  </div>
</div>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "name": {{ product.title | json }},
  "description": {{ product.description | strip_html | json }},
  "brand": { "@type": "Brand", "name": {{ shop.name | json }} },
  {%- if catalog %}"sku": {{ catalog | json }},{% endif %}
  {%- if product.featured_media %}"image": {{ product.featured_media.preview_image | image_url: width: 1200 | prepend: 'https:' | json }},{% endif %}
  "url": {{ request.origin | append: product.url | json }},
  "offers": {
    "@type": "Offer",
    "price": {{ current.price | divided_by: 100.0 | json }},
    "priceCurrency": {{ cart.currency.iso_code | json }},
    "availability": "https://schema.org/{% if current.available %}InStock{% else %}OutOfStock{% endif %}"
  }
}
</script>

{% schema %}
{
  "name": "Produkt",
  "settings": [
    { "type": "text", "id": "demo_label", "label": "Demo-Label", "default": "Demo anhören" },
    { "type": "text", "id": "demo_hint", "label": "Demo-Hinweis", "default": "Ausschnitt aus dem Kit, gemastert" },
    { "type": "text", "id": "delivery_note", "label": "Lieferhinweis", "default": "Sofort-Download nach dem Kauf · 24-bit WAV" },
    { "type": "textarea", "id": "highlights", "label": "Häkchen-Liste", "info": "Eine Zeile pro Punkt. Leer = ausblenden.", "default": "WAV 24-bit / 44,1 kHz\nBPM und Key im Dateinamen\nLäuft in jeder DAW, MPC und SP-404\n100 % royalty-free" },
    { "type": "text", "id": "license_spec", "label": "Lizenz in den Specs", "default": "Royalty-free" },
    { "type": "checkbox", "id": "show_exclusive", "label": "Hinweis „Exklusiv anfragen“ zeigen", "info": "Für Beats. Im Beat-Template aktiv.", "default": false },
    { "type": "text", "id": "exclusive_text", "label": "Text vor dem Link", "default": "Exklusivrechte?" },
    { "type": "url", "id": "exclusive_link", "label": "Link „Exklusiv anfragen“", "info": "Leer = Mail an die Shop-Adresse mit Beat-Titel im Betreff." },
    { "type": "richtext", "id": "license_text", "label": "Lizenz kurz", "default": "<ul><li>100 % royalty-free für eigene Releases, Beats, Werbung und Social</li><li>Keine Weitergabe oder Weiterverkauf der Rohsamples</li><li>Credit optional, aber gern gesehen</li></ul><p><a href=\"/pages/lizenz\">Komplette Lizenz lesen</a></p>" },
    { "type": "richtext", "id": "download_text", "label": "Download", "default": "<p>Nach dem Kauf bekommst du sofort einen Download-Link per Mail und auf der Bestellbestätigung. Die Dateien kommen als ZIP, sauber benannt und nach Typ sortiert.</p>" }
  ]
}
{% endschema %}
