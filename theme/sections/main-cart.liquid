<div class="wrap">
  <header class="coll-head"><h1 class="h1">Warenkorb</h1></header>
  {%- if cart.item_count == 0 -%}
    <div class="empty">
      <p class="h3">Noch leer.</p>
      <a class="btn" href="{{ routes.all_products_collection_url }}"><span class="btn__label">Kits ansehen</span></a>
    </div>
  {%- else -%}
    <div class="cart-page" style="padding-top:0">
      <div style="border-top:1px solid var(--ink)">
        {%- for item in cart.items -%}
          {% render 'cart-line', item: item, index: forloop.index %}
        {%- endfor -%}
      </div>
      <form class="cart-page__aside" action="{{ routes.cart_url }}" method="post" style="display:grid;gap:16px">
        <div class="total"><span>Summe</span><span class="mono">{{ cart.total_price | money }}</span></div>
        <p class="mono muted">{{ settings.cart_note_text }}</p>
        <button class="btn btn--block" type="submit" name="checkout"><span class="btn__label">Zur Kasse</span></button>
        <a class="mono link-arrow" href="{{ routes.all_products_collection_url }}">Weiter stöbern</a>
      </form>
    </div>
  {%- endif -%}
</div>
{% schema %}
{ "name": "Warenkorb" }
{% endschema %}
