<div class="wrap">
  <header class="coll-head"><span class="label">Shop</span><h1 class="h1">Kategorien</h1></header>
  <div class="tiles">
    {%- for c in collections -%}
      {%- if c.handle != 'frontpage' and c.products_count > 0 -%}
        <a class="tile" href="{{ c.url }}"><span class="tile__arrow" aria-hidden="true">↳</span><span class="tile__name">{{ c.title }}</span><span class="tile__count">{{ c.products_count }}</span></a>
      {%- endif -%}
    {%- endfor -%}
  </div>
  <div style="height:var(--sec-pad)"></div>
</div>
{% schema %}
{ "name": "Kategorien" }
{% endschema %}
