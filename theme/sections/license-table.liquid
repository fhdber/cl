{%- liquid
  assign rows = 'files,streams,sales,video,performance,radio,term' | split: ','
  assign mail_subject = 'Exklusiv-Anfrage'
  if product
    assign mail_subject = mail_subject | append: ': ' | append: product.title
  endif
  assign ex_link = section.settings.exclusive_link
  if ex_link == blank
    assign enc_subject = mail_subject | url_encode
    assign ex_link = 'mailto:' | append: shop.email | append: '?subject=' | append: enc_subject
  endif
-%}
<section class="sec lic" id="lizenzen">
  <div class="wrap">
    <div class="lic__head">
      {%- if section.settings.label != blank -%}<span class="label">{{ section.settings.label }}</span>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="h2">{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.intro != blank -%}<div class="rte lic__intro">{{ section.settings.intro }}</div>{%- endif -%}
    </div>

    <div class="lic__scroll" tabindex="0" role="region" aria-label="{{ 'license.compare' | t }}">
      <table class="lic__table">
        <thead>
          <tr>
            <th scope="col"><span class="visually-hidden">{{ 'product.license' | t }}</span></th>
            {%- for block in section.blocks -%}
              {%- liquid
                assign v = nil
                if product
                  for variant in product.variants
                    if variant.title == block.settings.name
                      assign v = variant
                    endif
                  endfor
                endif
              -%}
              <th scope="col" class="lic__tier{% if block.settings.featured %} is-featured{% endif %}" {{ block.shopify_attributes }}>
                <span class="lic__name">{{ block.settings.name }}</span>
                <span class="lic__price">
                  {%- if v -%}{{ v.price | money_without_trailing_zeros }}{%- else -%}{{ block.settings.price }}{%- endif -%}
                </span>
                {%- if v and v.available -%}
                  <button type="button" class="lic__pick ul" data-pick-variant="{{ v.id }}">{{ section.settings.pick_label }}</button>
                {%- endif -%}
              </th>
            {%- endfor -%}
            {%- if section.settings.show_exclusive -%}
              <th scope="col" class="lic__tier lic__tier--ex">
                <span class="lic__name">{{ section.settings.exclusive_title }}</span>
                <span class="lic__price">{{ section.settings.exclusive_price }}</span>
                <a class="lic__pick ul" href="{{ ex_link }}">{{ 'license.exclusive' | t }}</a>
              </th>
            {%- endif -%}
          </tr>
        </thead>
        <tbody>
          {%- for r in rows -%}
            {%- assign row_label_key = 'row_' | append: r -%}
            {%- assign row_label = section.settings[row_label_key] -%}
            {%- if row_label != blank -%}
              <tr>
                <th scope="row">{{ row_label }}</th>
                {%- for block in section.blocks -%}
                  <td{% if block.settings.featured %} class="is-featured"{% endif %}>{{ block.settings[r] | default: '–' }}</td>
                {%- endfor -%}
                {%- if section.settings.show_exclusive -%}
                  {%- assign ex_key = 'ex_' | append: r -%}
                  <td class="lic__ex">{{ section.settings[ex_key] | default: '–' }}</td>
                {%- endif -%}
              </tr>
            {%- endif -%}
          {%- endfor -%}
        </tbody>
      </table>
    </div>

    {%- if section.settings.note != blank -%}<div class="rte meta lic__note">{{ section.settings.note }}</div>{%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Lizenz-Vergleich",
  "class": "section-license",
  "settings": [
    { "type": "text", "id": "label", "label": "Label", "default": "Leasing" },
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Lizenzen im Vergleich" },
    { "type": "richtext", "id": "intro", "label": "Intro", "default": "<p>Alle Leases sind nicht-exklusiv und sofort nutzbar. Der Lizenzvertrag kommt als PDF mit dem Download.</p>" },
    { "type": "text", "id": "pick_label", "label": "Button „Auswählen“ (nur auf Produktseiten)", "default": "Auswählen" },
    { "type": "header", "content": "Zeilen", "info": "Leere Zeilenbezeichnung = Zeile ausblenden." },
    { "type": "text", "id": "row_files", "label": "Zeile 1", "default": "Dateien" },
    { "type": "text", "id": "row_streams", "label": "Zeile 2", "default": "Streams" },
    { "type": "text", "id": "row_sales", "label": "Zeile 3", "default": "Verkäufe / Downloads" },
    { "type": "text", "id": "row_video", "label": "Zeile 4", "default": "Musikvideos" },
    { "type": "text", "id": "row_performance", "label": "Zeile 5", "default": "Live-Auftritte" },
    { "type": "text", "id": "row_radio", "label": "Zeile 6", "default": "Radio / TV" },
    { "type": "text", "id": "row_term", "label": "Zeile 7", "default": "Laufzeit" },
    { "type": "header", "content": "Exklusiv" },
    { "type": "checkbox", "id": "show_exclusive", "label": "Spalte „Exklusiv“ zeigen", "default": true },
    { "type": "text", "id": "exclusive_title", "label": "Titel", "default": "Exklusiv" },
    { "type": "text", "id": "exclusive_price", "label": "Preis-Text", "default": "Auf Anfrage" },
    { "type": "url", "id": "exclusive_link", "label": "Link „Anfragen“", "info": "Leer = Mail an die Shop-Adresse mit Beat-Titel im Betreff." },
    { "type": "text", "id": "ex_files", "label": "Zeile 1", "default": "Stems + WAV + MP3" },
    { "type": "text", "id": "ex_streams", "label": "Zeile 2", "default": "Unbegrenzt" },
    { "type": "text", "id": "ex_sales", "label": "Zeile 3", "default": "Unbegrenzt" },
    { "type": "text", "id": "ex_video", "label": "Zeile 4", "default": "Unbegrenzt" },
    { "type": "text", "id": "ex_performance", "label": "Zeile 5", "default": "Ja" },
    { "type": "text", "id": "ex_radio", "label": "Zeile 6", "default": "Ja" },
    { "type": "text", "id": "ex_term", "label": "Zeile 7", "default": "Unbefristet, Beat geht vom Markt" },
    { "type": "richtext", "id": "note", "label": "Hinweis unten", "default": "<p>Credit bei jeder Lizenz: „prod. by CONTRABEATZ“. Der Beat darf nicht bei YouTube Content ID oder anderen Fingerprinting-Diensten registriert werden. Wird ein Beat exklusiv verkauft, bleiben alle vorher gekauften Leases gültig. <a href=\"/pages/lizenz\">Komplette Lizenzbedingungen</a></p>" }
  ],
  "blocks": [
    {
      "type": "tier",
      "name": "Lizenzstufe",
      "limit": 6,
      "settings": [
        { "type": "text", "id": "name", "label": "Name", "default": "MP3 Lease", "info": "Auf Produktseiten wird der Preis automatisch aus der Variante mit genau diesem Namen gezogen." },
        { "type": "text", "id": "price", "label": "Preis-Text (wenn keine passende Variante)", "default": "29 €" },
        { "type": "checkbox", "id": "featured", "label": "Hervorheben", "default": false },
        { "type": "text", "id": "files", "label": "Zeile 1", "default": "MP3 320 kbps" },
        { "type": "text", "id": "streams", "label": "Zeile 2", "default": "100.000" },
        { "type": "text", "id": "sales", "label": "Zeile 3", "default": "2.000" },
        { "type": "text", "id": "video", "label": "Zeile 4", "default": "1" },
        { "type": "text", "id": "performance", "label": "Zeile 5", "default": "Ja" },
        { "type": "text", "id": "radio", "label": "Zeile 6", "default": "–" },
        { "type": "text", "id": "term", "label": "Zeile 7", "default": "2 Jahre" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Lizenz-Vergleich",
      "blocks": [
        { "type": "tier", "settings": { "name": "MP3 Lease", "price": "29 €" } },
        { "type": "tier", "settings": { "name": "WAV Lease", "price": "49 €", "files": "WAV + MP3", "streams": "250.000", "sales": "5.000", "radio": "2 Sender", "term": "3 Jahre" } },
        { "type": "tier", "settings": { "name": "Trackout Lease", "price": "99 €", "featured": true, "files": "Stems + WAV + MP3", "streams": "500.000", "sales": "10.000", "video": "3", "radio": "Ja", "term": "5 Jahre" } },
        { "type": "tier", "settings": { "name": "Unlimited", "price": "199 €", "files": "Stems + WAV + MP3", "streams": "Unbegrenzt", "sales": "Unbegrenzt", "video": "Unbegrenzt", "radio": "Ja", "term": "Unbefristet" } }
      ]
    }
  ]
}
{% endschema %}
