<section class="section{% if section.settings.rule %} section--rule{% endif %}">
  <div class="wrap">
    <div class="split">
      <p class="mono muted">{{ section.settings.kicker }}</p>
      <div style="display:grid;gap:32px">
        <h2 class="h2" style="max-width:20ch">{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}<div class="rte muted">{{ section.settings.text }}</div>{%- endif -%}
        {%- if section.settings.link_label != blank -%}<a class="mono link-arrow" href="{{ section.settings.link }}">{{ section.settings.link_label }}</a>{%- endif -%}
      </div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Statement",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Herkunft" },
    { "type": "textarea", "id": "heading", "label": "Headline", "default": "Aufgenommen und gemischt im LUX Studio in Berlin-Friedrichshain." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Hinter CONTRABEATZ steht Producer und Komponist Florian Hierholzer. Die Sounds kommen aus Werbemusik, Artist-Produktionen und Sessions, aussortiert, nachbearbeitet und sauber benannt.</p>" },
    { "type": "text", "id": "link_label", "label": "Link-Text", "default": "contrabeatz.de" },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "checkbox", "id": "rule", "label": "Trennlinie oben", "default": true }
  ],
  "presets": [ { "name": "Statement" } ]
}
{% endschema %}
