{%- comment -%}
  Modulares, randloses Raster (inspiriert von Balmoral): große Editorial-Kacheln
  mischen sich mit einzelnen Produktkacheln. 4 Spalten, enge Fugen.
{%- endcomment -%}
<section class="edge-sec" id="{{ section.id }}">
  {%- if section.settings.heading != blank -%}
    <div class="head head--edge">
      <span class="label">{{ section.settings.heading }}</span>
      {%- if section.settings.link_label != blank -%}<a class="link" href="{{ section.settings.link }}">{{ section.settings.link_label }}</a>{%- endif -%}
    </div>
  {%- endif -%}
  <div class="edge-grid" style="--cols: 4">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'story' -%}
          <a class="story story--{{ block.settings.size }}{% if block.settings.align == 'right' %} story--right{% endif %}" href="{{ block.settings.link | default: '#' }}" style="--story-bg: {{ block.settings.bg }}" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 2000 | image_tag: class: 'story__img', loading: 'lazy', alt: block.settings.image.alt, sizes: '(min-width: 820px) 50vw, 100vw', widths: '600, 900, 1200, 1600, 2000' }}
            {%- else -%}
              <span class="story__emblem">{% render 'cb-emblem' %}</span>
            {%- endif -%}
            <span class="story__title">{{ block.settings.title }}</span>
            {%- if block.settings.text != blank or block.settings.link_label != blank -%}
              <span class="story__text">
                {%- if block.settings.kicker != blank -%}<span class="story__kicker">{{ block.settings.kicker }}</span>{%- endif -%}
                {{ block.settings.text }}
                {%- if block.settings.link_label != blank -%}<span class="story__link">{{ block.settings.link_label }}</span>{%- endif -%}
              </span>
            {%- endif -%}
          </a>
        {%- when 'product' -%}
          {%- if block.settings.product != blank -%}
            <div {{ block.shopify_attributes }}>{% render 'product-tile', product: block.settings.product %}</div>
          {%- endif -%}
        {%- when 'collection' -%}
          {%- for p in block.settings.collection.products limit: block.settings.limit -%}
            {% render 'product-tile', product: p %}
          {%- endfor -%}
      {%- endcase -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Editorial-Raster",
  "settings": [
    { "type": "text", "id": "heading", "label": "Label (optional)" },
    { "type": "text", "id": "link_label", "label": "Link-Text", "default": "Shop" },
    { "type": "url", "id": "link", "label": "Link" }
  ],
  "blocks": [
    { "type": "story", "name": "Editorial-Kachel", "settings": [
      { "type": "select", "id": "size", "label": "Größe", "default": "large", "options": [
        { "value": "large", "label": "Groß (2 × 2)" },
        { "value": "wide", "label": "Breit (2 × 1)" },
        { "value": "full", "label": "Volle Breite" }
      ] },
      { "type": "select", "id": "align", "label": "Position", "default": "left", "options": [
        { "value": "left", "label": "Links" }, { "value": "right", "label": "Rechts" }
      ] },
      { "type": "image_picker", "id": "image", "label": "Bild" },
      { "type": "color", "id": "bg", "label": "Fläche ohne Bild", "default": "#0D0D0D" },
      { "type": "text", "id": "title", "label": "Titel", "default": "Drum Kits" },
      { "type": "text", "id": "kicker", "label": "Kleine Überschrift", "default": "Herbst 2026" },
      { "type": "textarea", "id": "text", "label": "Text", "default": "Kicks mit Gewicht, Snares mit Luft. Aufgenommen im LUX Studio in Berlin-Friedrichshain." },
      { "type": "text", "id": "link_label", "label": "Link-Text", "default": "Shop Drum Kits" },
      { "type": "url", "id": "link", "label": "Link" }
    ] },
    { "type": "product", "name": "Produkt", "settings": [ { "type": "product", "id": "product", "label": "Produkt" } ] },
    { "type": "collection", "name": "Produkte aus Kollektion", "settings": [
      { "type": "collection", "id": "collection", "label": "Kollektion" },
      { "type": "range", "id": "limit", "label": "Anzahl", "min": 1, "max": 8, "step": 1, "default": 2 }
    ] }
  ],
  "presets": [ { "name": "Editorial-Raster" } ]
}
{% endschema %}
