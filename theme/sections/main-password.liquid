{%- comment -%}
  Teaser / Passwortseite: gleiche Bühne wie die Startseite (CONTRA + SHOP-Tag, identische Größe),
  Kopfzeile wie im Shop, unten Headline, Mail-Eintrag und Socials.
{%- endcomment -%}
<div class="teaser">
  <header class="teaser__top">
    <span class="label">{{ section.settings.label }}</span>
    <span class="brand" aria-hidden="true">{% render 'cb-emblem' %}</span>
    <div class="teaser__actions">
      {% render 'localization', style: 'lang', form_id: 'loc-teaser' %}
      <button type="button" class="ul" data-teaser-open="pw">{{ 'password.password' | t }}</button>
    </div>
  </header>

  <section class="stage teaser__stage" data-tag="bottom" data-stage style="--tag-size: {{ section.settings.tag_size | divided_by: 100.0 }}; --tag-color: {{ section.settings.tag_color }};">
    <div class="stage__mark" data-stage-mark>
      {% render 'contra-wordmark', uid: 'pw', tag: true, solid: true, class: 'cb-contra' %}
    </div>
    <h1 class="visually-hidden">{{ shop.name }} – {{ section.settings.heading }}</h1>
  </section>

  <div class="teaser__bottom">
    <div class="teaser__copy">
      <p class="teaser__heading">{{ section.settings.heading }}</p>
      {%- if section.settings.text != blank -%}<p class="teaser__text">{{ section.settings.text }}</p>{%- endif -%}
    </div>
    <div class="teaser__form">
      {%- form 'customer', class: 'line-input teaser__input' -%}
        <input type="hidden" name="contact[tags]" value="prelaunch,newsletter">
        {%- if form.posted_successfully? -%}
          <p class="teaser__ok" role="status">{{ 'newsletter.thanks' | t }}</p>
        {%- else -%}
          <label class="visually-hidden" for="pw-email">{{ 'general.email' | t }}</label>
          <input id="pw-email" type="email" name="contact[email]" placeholder="{{ section.settings.placeholder }}" required autocomplete="email">
          <button type="submit" aria-label="{{ 'password.notify' | t }}">↳</button>
        {%- endif -%}
      {%- endform -%}
      {%- if section.settings.form_note != blank -%}<p class="teaser__note">{{ section.settings.form_note }}</p>{%- endif -%}
    </div>
  </div>

  <footer class="teaser__bar">
    <nav aria-label="Social">
      {%- if settings.social_instagram != blank -%}<a href="{{ settings.social_instagram }}" target="_blank" rel="noopener">Instagram</a>{%- endif -%}
      {%- if settings.social_tiktok != blank -%}<a href="{{ settings.social_tiktok }}" target="_blank" rel="noopener">TikTok</a>{%- endif -%}
      {%- if settings.social_youtube != blank -%}<a href="{{ settings.social_youtube }}" target="_blank" rel="noopener">YouTube</a>{%- endif -%}
      {%- if settings.social_spotify != blank -%}<a href="{{ settings.social_spotify }}" target="_blank" rel="noopener">Spotify</a>{%- endif -%}
    </nav>
    <nav aria-label="{{ 'general.legal' | t }}">
      <button type="button" data-teaser-open="imprint">Impressum</button>
      <a href="/policies/privacy-policy">Datenschutz</a>
      <span class="teaser__copy-year">© {{ shop.name }} {{ 'now' | date: '%Y' }}</span>
    </nav>
  </footer>

  {%- comment -%} Overlays {%- endcomment -%}
  <div class="teaser__panel" data-teaser-panel="pw" hidden>
    <div class="teaser__panel-inner">
      <button type="button" class="teaser__close ul" data-teaser-close>{{ 'general.close' | t }}</button>
      <span class="label">{{ 'password.enter' | t }}</span>
      {%- form 'storefront_password', class: 'line-input teaser__input' -%}
        <label class="visually-hidden" for="pw">{{ 'password.password' | t }}</label>
        <input id="pw" type="password" name="password" placeholder="{{ 'password.password' | t }}" autocomplete="current-password">
        <button type="submit" aria-label="{{ 'password.open' | t }}">↳</button>
      {%- endform -%}
    </div>
  </div>
  <div class="teaser__panel" data-teaser-panel="imprint" hidden>
    <div class="teaser__panel-inner teaser__panel-inner--text">
      <button type="button" class="teaser__close ul" data-teaser-close>{{ 'general.close' | t }}</button>
      <span class="label">Impressum</span>
      <div class="rte">
        {%- assign imp = pages[section.settings.imprint_page] -%}
        {%- if imp != blank and imp.content != blank -%}{{ imp.content }}{%- else -%}{{ section.settings.imprint_fallback }}{%- endif -%}
      </div>
    </div>
  </div>
</div>

{%- comment -%} Passwort-Fehler: Panel direkt offen zeigen {%- endcomment -%}
{%- form 'storefront_password' -%}{%- if form.errors -%}<script>document.addEventListener('DOMContentLoaded',function(){var p=document.querySelector('[data-teaser-panel="pw"]');if(p){p.hidden=false;}});</script>{%- endif -%}{%- endform -%}

<script>
  document.addEventListener('click', function (e) {
    var o = e.target.closest('[data-teaser-open]');
    if (o) { var p = document.querySelector('[data-teaser-panel="' + o.dataset.teaserOpen + '"]'); if (p) { p.hidden = false; var i = p.querySelector('input:not([type=hidden])'); if (i) i.focus(); } return; }
    if (e.target.closest('[data-teaser-close]') || e.target.matches('[data-teaser-panel]')) { document.querySelectorAll('[data-teaser-panel]').forEach(function (p) { p.hidden = true; }); }
  });
  document.addEventListener('keydown', function (e) { if (e.key === 'Escape') document.querySelectorAll('[data-teaser-panel]').forEach(function (p) { p.hidden = true; }); });
</script>

{% schema %}
{
  "name": "Teaser",
  "settings": [
    { "type": "text", "id": "label", "label": "Label oben links", "default": "Opening Herbst 2026" },
    { "type": "text", "id": "heading", "label": "Headline", "default": "Bald geöffnet." },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Drum Kits, One Shots und Sample Packs aus dem LUX Studio Berlin. Trag dich ein und hol dir zum Start das Free Pack." },
    { "type": "text", "id": "placeholder", "label": "Platzhalter Mail-Feld", "default": "Deine E-Mail für den Start" },
    { "type": "text", "id": "form_note", "label": "Hinweis unter dem Mail-Feld", "default": "Kein Spam. Abmeldung jederzeit." },
    { "type": "color", "id": "tag_color", "label": "Farbe SHOP-Tag", "default": "#D0532A" },
    { "type": "range", "id": "tag_size", "label": "Größe SHOP-Tag", "min": 60, "max": 140, "step": 5, "unit": "%", "default": 100 },
    { "type": "header", "content": "Impressum" },
    { "type": "text", "id": "imprint_page", "label": "Seiten-Handle", "default": "impressum", "info": "Der Inhalt dieser Seite erscheint im Impressum-Overlay." },
    { "type": "richtext", "id": "imprint_fallback", "label": "Ersatztext, falls die Seite fehlt", "default": "<p>Florian Hierholzer · CONTRABEATZ · c/o LUX Studio Berlin, Atelier 303 · Storkower Straße 175 · 10369 Berlin · info@contrabeatz.de</p>" }
  ]
}
{% endschema %}
