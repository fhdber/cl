<div class="password">
  <div class="password__inner">
    {% render 'contra-wordmark', uid: 'pw', tag: true, class: 'cb-contra' %}
    <p class="lead">{{ section.settings.text }}</p>
    {%- form 'customer', class: 'line-input' -%}
      <input type="hidden" name="contact[tags]" value="prelaunch">
      <label class="visually-hidden" for="pw-email">E-Mail</label>
      <input id="pw-email" type="email" name="contact[email]" placeholder="E-Mail-Adresse" required>
      <button type="submit" aria-label="Benachrichtigen">↳</button>
      {%- if form.posted_successfully? -%}<p class="mono">Danke. Du hörst als Erstes davon.</p>{%- endif -%}
    {%- endform -%}
    <details>
      <summary class="mono muted" style="cursor:pointer">Passwort eingeben</summary>
      {%- form 'storefront_password', class: 'line-input', style: 'margin-top:16px' -%}
        <label class="visually-hidden" for="pw">Passwort</label>
        <input id="pw" type="password" name="password" placeholder="Passwort">
        <button type="submit" aria-label="Öffnen">↳</button>
        {%- if form.errors -%}<p class="mono" role="alert">{{ form.errors | default_errors }}</p>{%- endif -%}
      {%- endform -%}
    </details>
  </div>
</div>
{% schema %}
{
  "name": "Passwort-Seite",
  "settings": [ { "type": "text", "id": "text", "label": "Text", "default": "Der Shop öffnet bald. Trag dich ein und hol dir das Free Pack zum Start." } ]
}
{% endschema %}
