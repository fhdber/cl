<div class="wrap">
  <header class="coll-head">
    <span class="label">Suche</span><h1 class="h1">Was suchst du?</h1>
    <form action="{{ routes.search_url }}" method="get" role="search" class="line-input" style="width:min(640px,100%)">
      <input type="hidden" name="type" value="product">
      <label class="visually-hidden" for="q">{{ 'search.term' | t }}</label>
      <input id="q" type="search" name="q" value="{{ search.terms | escape }}" placeholder="Kick, Trap, 140 BPM …" autofocus>
      <button type="submit" aria-label="{{ 'search.submit' | t }}">↳</button>
    </form>
  </header>
  {%- if search.performed -%}
    <p class="meta" style="margin-bottom:48px">{{ search.results_count }} Ergebnisse für „{{ search.terms | escape }}“</p>
    {%- paginate search.results by 48 -%}
      {%- if search.results_count > 0 -%}
        <div class="grid">
          {%- for item in search.results -%}
            {%- if item.object_type == 'product' -%}
              {% render 'product-card', product: item %}
            {%- else -%}
              <a href="{{ item.url }}" class="h3">{{ item.title }}</a>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- else -%}
        <div class="empty"><p class="h3">{{ 'search.none' | t }}</p><a class="link" href="{{ routes.all_products_collection_url }}">{{ 'general.all_kits' | t }}</a></div>
      {%- endif -%}
    {%- endpaginate -%}
  {%- endif -%}
  <div style="height:var(--sec-pad)"></div>
</div>
{% schema %}
{ "name": "Suche" }
{% endschema %}
