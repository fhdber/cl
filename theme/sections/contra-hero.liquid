<section class="stage{% if section.settings.static %} stage--static{% endif %}" data-tag="{{ section.settings.tag }}" data-tag-parallax="{{ section.settings.tag_parallax }}" data-stage style="--tag-size: {{ section.settings.tag_size | divided_by: 100.0 }}; --tag-color: {{ section.settings.tag_color }};">
  <div class="stage__mark" data-stage-mark>
    {%- assign show_tag = true -%}
    {%- if section.settings.tag == 'none' -%}{%- assign show_tag = false -%}{%- endif -%}
    {%- assign solid_tag = false -%}{%- if section.settings.tag == 'bottom' -%}{%- assign solid_tag = true -%}{%- endif -%}
    {% render 'contra-wordmark', uid: section.id, tag: show_tag, solid: solid_tag, class: 'cb-contra' %}
  </div>
  {%- if section.settings.link != blank -%}
    <a class="stage__link" href="{{ section.settings.link }}" aria-label="{{ section.settings.link_label | default: 'Zum Shop' | escape }}"></a>
  {%- endif -%}
  {%- if section.settings.cue != blank -%}
    <div class="stage__cue" aria-hidden="true">{{ section.settings.cue }}<i></i></div>
  {%- endif -%}
  <h1 class="visually-hidden">{{ section.settings.heading | default: shop.name }}</h1>
</section>

{% schema %}
{
  "name": "CONTRA-Bühne",
  "settings": [
    { "type": "select", "id": "tag", "label": "Spray-Tag „Shop“", "default": "bottom", "options": [
      { "value": "bottom", "label": "Mittig unten, überlappend" },
      { "value": "side", "label": "Rechts neben CONTRA" },
      { "value": "over", "label": "Über R und A" },
      { "value": "none", "label": "Ohne Tag" }
    ] },
    { "type": "color", "id": "tag_color", "label": "Farbe des Tags (Position „Mittig unten“)", "default": "#D0532A" },
    { "type": "range", "id": "tag_size", "label": "Größe des Tags", "min": 60, "max": 140, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "tag_parallax", "label": "Parallaxe des Tags", "info": "Der Tag steigt beim Scrollen schneller als CONTRA. 0 = aus.", "min": 0, "max": 200, "step": 10, "unit": "%", "default": 100 },
    { "type": "checkbox", "id": "static", "label": "Ohne Sticky-Effekt", "info": "Aus: Die Bühne bleibt stehen und die Sektionen darunter schieben sich darüber.", "default": false },
    { "type": "text", "id": "cue", "label": "Scroll-Hinweis", "default": "Scroll" },
    { "type": "url", "id": "link", "label": "Klick auf die Bühne führt zu" },
    { "type": "text", "id": "link_label", "label": "Link-Beschreibung (Screenreader)", "default": "Zum Shop" },
    { "type": "text", "id": "heading", "label": "Unsichtbare H1 (SEO)", "default": "CONTRABEATZ Shop: Drum Kits, One Shots und Sample Packs" }
  ],
  "presets": [ { "name": "CONTRA-Bühne" } ]
}
{% endschema %}
