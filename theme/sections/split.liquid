{%- assign p = section.settings.product -%}
<section class="section{% if section.settings.dark %} section--dark{% endif %}">
  <div class="wrap split{% if section.settings.reverse %} split--reverse{% endif %}">
    <div class="split__media">
      {%- if section.settings.image != blank -%}
        <div class="cover">{{ section.settings.image | image_url: width: 1600 | image_tag: widths: '540, 900, 1200, 1600', sizes: '(min-width: 1024px) 50vw, 100vw', loading: 'lazy' }}</div>
      {%- elsif p != blank -%}
        <div class="card__media">{% render 'cover', product: p, sizes: '(min-width: 1024px) 50vw, 100vw' %}{% render 'play-button', product: p %}</div>
      {%- endif -%}
    </div>
    <div class="split__text">
      {%- if section.settings.kicker != blank -%}<p class="mono muted">{{ section.settings.kicker }}</p>{%- endif -%}
      <h2 class="h1">{{ section.settings.heading }}</h2>
      <div class="lead">{{ section.settings.text }}</div>
      {%- if section.settings.button_label != blank -%}
        <div><a class="btn" href="{{ section.settings.button_link | default: p.url }}"><span class="btn__label">{{ section.settings.button_label }}</span></a></div>
      {%- endif -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Bild + Text",
  "settings": [
    { "type": "product", "id": "product", "label": "Produkt (Cover + Demo)" },
    { "type": "image_picker", "id": "image", "label": "Bild (statt Produkt-Cover)" },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Free Pack" },
    { "type": "textarea", "id": "heading", "label": "Headline", "default": "Erst hören. Dann entscheiden." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Ein Kit zum Reinhören, komplett kostenlos. Gleiche Qualität wie in jedem Bezahl-Kit, gleiche Lizenz.</p>" },
    { "type": "text", "id": "button_label", "label": "Button", "default": "Kostenlos laden" },
    { "type": "url", "id": "button_link", "label": "Button Link" },
    { "type": "checkbox", "id": "reverse", "label": "Bild rechts", "default": false },
    { "type": "checkbox", "id": "dark", "label": "Dunkle Fläche", "default": false }
  ],
  "presets": [ { "name": "Bild + Text" } ]
}
{% endschema %}
