{%- liquid
  assign feature = section.settings.product
  if feature == blank and section.settings.collection != blank
    assign feature = section.settings.collection.products.first
  endif
  if feature == blank
    assign feature = collections.all.products.first
  endif
-%}
<section class="hero">
  <div class="wrap hero__grid">
    <div class="hero__text">
      {%- if section.settings.kicker != blank -%}<p class="mono muted">{{ section.settings.kicker }}</p>{%- endif -%}
      <h1 class="display">{{ section.settings.heading }}</h1>
      {%- if section.settings.text != blank -%}<div class="lead">{{ section.settings.text }}</div>{%- endif -%}
      <div class="hero__actions">
        {%- if section.settings.button_label != blank -%}
          <a class="btn" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}"><span class="btn__label">{{ section.settings.button_label }}</span></a>
        {%- endif -%}
        {%- if section.settings.button2_label != blank -%}
          <a class="btn btn--ghost" href="{{ section.settings.button2_link | default: routes.all_products_collection_url }}"><span class="btn__label">{{ section.settings.button2_label }}</span></a>
        {%- endif -%}
      </div>
      {%- if section.blocks.size > 0 -%}
        <ul class="hero__facts mono">
          {%- for block in section.blocks -%}<li {{ block.shopify_attributes }}>{{ block.settings.text }}</li>{%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
    {%- if feature != blank -%}
      <div class="hero__feature">
        <p class="mono muted">{{ section.settings.feature_label }}</p>
        {% render 'product-card', product: feature, sizes: '(min-width: 1024px) 34vw, 100vw' %}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Sample Library aus dem Studio" },
    { "type": "textarea", "id": "heading", "label": "Headline", "default": "Sounds, die schon gearbeitet haben." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Drum Kits, One Shots und Loops aus echten Produktionen. Gemischt, getaggt, royalty-free. Sofort im Download.</p>" },
    { "type": "text", "id": "button_label", "label": "Button 1", "default": "Alle Kits" },
    { "type": "url", "id": "button_link", "label": "Button 1 Link" },
    { "type": "text", "id": "button2_label", "label": "Button 2", "default": "Free Pack" },
    { "type": "url", "id": "button2_link", "label": "Button 2 Link" },
    { "type": "header", "content": "Release rechts" },
    { "type": "text", "id": "feature_label", "label": "Label", "default": "Neu" },
    { "type": "product", "id": "product", "label": "Produkt", "info": "Leer = neuestes Produkt der gewählten Kollektion" },
    { "type": "collection", "id": "collection", "label": "Kollektion" }
  ],
  "blocks": [
    { "type": "fact", "name": "Fakt", "limit": 4, "settings": [ { "type": "text", "id": "text", "label": "Text", "default": "24-bit WAV" } ] }
  ],
  "presets": [ { "name": "Hero" } ]
}
{% endschema %}
