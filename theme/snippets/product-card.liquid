<article class="card">
  <div class="card__media rvimg">
    {% render 'cover', product: product, sizes: sizes %}
    {% render 'play-button', product: product %}
  </div>
  <h3 class="card__title"><a href="{{ product.url }}">{{ product.title }}</a></h3>
  {% render 'meta-line', product: product %}
  <div class="card__price">{% render 'price', product: product %}</div>
</article>
