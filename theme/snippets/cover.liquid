{%- comment -%}
  Cover im Layout-Duktus: Packshot (optional Schwarz-Weiß) oder schwarze Fläche mit Waveform.
  Usage: {% render 'cover', product: product, sizes: '…', loading: 'eager' %}
{%- endcomment -%}
{%- liquid
  assign img = image | default: product.featured_media.preview_image
  assign sizes = sizes | default: '(min-width: 1100px) 33vw, (min-width: 560px) 50vw, 100vw'
  assign load = loading | default: 'lazy'
  assign alt_text = img.alt | default: product.title
  assign cover_class = 'cover'
  if img and settings.card_grayscale
    assign cover_class = 'cover cover--mono'
  endif
-%}
<div class="{{ cover_class }}">
  {%- if img -%}
    {{ img | image_url: width: 1600 | image_tag: widths: '360, 540, 720, 900, 1200, 1600', sizes: sizes, loading: load, alt: alt_text }}
  {%- else -%}
    {%- if settings.card_cover_meta -%}
      <div class="cover__row cover__row--top" aria-hidden="true">
        <span>{{ product.metafields.specs.catalog_number.value }}</span>
        <span>{{ product.type }}</span>
      </div>
    {%- endif -%}
  {%- endif -%}
  {% render 'waveform', seed: product.id %}
</div>
