{%- liquid
  assign f500 = settings.font_body | font_modify: 'weight', '500'
  assign f600 = settings.font_body | font_modify: 'weight', '600'
  assign f700 = settings.font_body | font_modify: 'weight', '700'
-%}
<style>
  {{ settings.font_body | font_face: font_display: 'swap' }}
  {%- if f500 %}{{ f500 | font_face: font_display: 'swap' }}{% endif -%}
  {%- if f600 %}{{ f600 | font_face: font_display: 'swap' }}{% endif -%}
  {%- if f700 %}{{ f700 | font_face: font_display: 'swap' }}{% endif -%}

  :root {
    --bg: {{ settings.color_bg }};
    --bg-soft: color-mix(in srgb, {{ settings.color_bg }} 92%, #E8E6E1);
    --ink: {{ settings.color_ink }};
    --ink-2: {{ settings.color_ink_2 }};
    --mute: {{ settings.color_mute }};
    --body-mute: {{ settings.color_body_mute }};
    --dot: color-mix(in srgb, {{ settings.color_mute }} 55%, {{ settings.color_bg }});
    --line: color-mix(in srgb, {{ settings.color_ink }} 8%, transparent);
    --line-strong: color-mix(in srgb, {{ settings.color_ink }} 16%, transparent);
    --accent: {{ settings.color_accent }};
    --accent-2: {{ settings.color_accent_2 }};
    --cover-bg: {{ settings.color_cover_bg }};
    --sans: {{ settings.font_body.family }}, -apple-system, "Helvetica Neue", Arial, sans-serif;
    --heading-scale: {{ settings.heading_scale | divided_by: 100.0 }};
    --edge: {{ settings.edge }}px;
    --sec-pad: {{ settings.section_padding }}px;
    --gap: {{ settings.grid_gap }}px;
    --logo-h: {{ settings.logo_height }}px;
    --contra-scale: {{ settings.contra_scale | divided_by: 100.0 }};
  }
</style>
