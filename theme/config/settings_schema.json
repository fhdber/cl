      { "type": "color", "id": "color_accent", "label": "Signalfarbe", "info": "Nur für Play-Status, Sale und Fokus. Sparsam.", "default": "#FF3D00" },
      { "type": "color", "id": "color_footer_bg", "label": "Footer Hintergrund", "default": "#0B0B0B" },
      { "type": "color", "id": "color_footer_ink", "label": "Footer Text", "default": "#F4F4F2" }
