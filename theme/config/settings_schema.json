      { "type": "range", "id": "heading_scale", "label": "Headline-Größe", "min": 80, "max": 130, "step": 5, "unit": "%", "default": 100 }
    ]
  },
  {
    "name": "Cover-System",
    "settings": [
      { "type": "paragraph", "content": "Produkte ohne Bild bekommen automatisch ein typografisches Cover. Die Form ergibt sich aus dem Produkttyp (Drum Kit = Step-Raster, One Shot = Punkt, Loop = Kreis, MIDI = Piano-Roll …), die Farbe rotiert durch diese sechs Töne. Sobald du ein Produktbild hochlädst, ersetzt es das Cover." },
      { "type": "color", "id": "cover_1", "label": "Cover-Farbe 1", "default": "#0B0B0B" },
      { "type": "color", "id": "cover_2", "label": "Cover-Farbe 2", "default": "#FF3D00" },
      { "type": "color", "id": "cover_3", "label": "Cover-Farbe 3", "default": "#D9D9D4" },
      { "type": "color", "id": "cover_4", "label": "Cover-Farbe 4", "default": "#2B3BFF" },
      { "type": "color", "id": "cover_5", "label": "Cover-Farbe 5", "default": "#C8F031" },
      { "type": "color", "id": "cover_6", "label": "Cover-Farbe 6", "default": "#8E8E88" },
      { "type": "select", "id": "card_meta", "label": "Meta-Zeile unter Produktkarten", "default": "type_count", "options": [
        { "value": "type_count", "label": "Typ · Anzahl Samples" },
        { "value": "type_bpm", "label": "Typ · BPM" },
        { "value": "type", "label": "Nur Typ" }
      ] }
    ]
