[
  {
    "name": "theme_info",
    "theme_name": "CONTRABEATZ",
    "theme_version": "2.0.0",
    "theme_author": "CONTRABEATZ",
    "theme_documentation_url": "https://contrabeatz.shop",
    "theme_support_url": "https://contrabeatz.shop/pages/contact"
  },
  {
    "name": "Marke",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo (optional)",
        "info": "Leer = CB-Emblem aus dem Layout."
      },
      {
        "type": "range",
        "id": "logo_height",
        "label": "Logo-Höhe",
        "min": 20,
        "max": 60,
        "step": 1,
        "unit": "px",
        "default": 35
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon"
      },
      {
        "type": "image_picker",
        "id": "share_image",
        "label": "Social-Sharing-Bild",
        "info": "1200 × 630 px"
      }
    ]
  },
  {
    "name": "Farben",
    "settings": [
      {
        "type": "color",
        "id": "color_bg",
        "label": "Hintergrund (Paper)",
        "default": "#FFFFFF"
      },
      {
        "type": "color",
        "id": "color_ink",
        "label": "Ink",
        "default": "#0D0D0D"
      },
      {
        "type": "color",
        "id": "color_ink_2",
        "label": "Ink 2 (Kacheln im Wechsel)",
        "default": "#1B1A18"
      },
      {
        "type": "color",
        "id": "color_mute",
        "label": "Meta-Text",
        "default": "#8A8A85"
      },
      {
        "type": "color",
        "id": "color_body_mute",
        "label": "Fließtext gedämpft",
        "default": "#54524D"
      },
      {
        "type": "color",
        "id": "color_accent",
        "label": "Akzent (Orange)",
        "info": "Label-Punkte, Hover, Play-Status",
        "default": "#D0532A"
      },
      {
        "type": "color",
        "id": "color_accent_2",
        "label": "Zweitakzent (Lime)",
        "default": "#57AC6C"
      },
      {
        "type": "color",
        "id": "color_cover_bg",
        "label": "Cover-Hintergrund ohne Bild",
        "default": "#0D0D0D"
      }
    ]
  },
  {
    "name": "Typografie",
    "settings": [
      {
        "type": "font_picker",
        "id": "font_body",
        "label": "Schrift",
        "default": "inter_n4"
      },
      {
        "type": "range",
        "id": "heading_scale",
        "label": "Headline-Größe",
        "min": 80,
        "max": 130,
        "step": 5,
        "unit": "%",
        "default": 100
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "range",
        "id": "edge",
        "label": "Seitenrand Desktop",
        "min": 16,
        "max": 120,
        "step": 4,
        "unit": "px",
        "default": 40
      },
      {
        "type": "range",
        "id": "section_padding",
        "label": "Abstand zwischen Sektionen",
        "min": 48,
        "max": 200,
        "step": 8,
        "unit": "px",
        "default": 120
      },
      {
        "type": "range",
        "id": "grid_gap",
        "label": "Spaltenabstand Produkt-Raster",
        "min": 8,
        "max": 64,
        "step": 4,
        "unit": "px",
        "default": 40
      }
    ]
  },
  {
    "name": "Produktkarten",
    "settings": [
      {
        "type": "checkbox",
        "id": "card_grayscale",
        "label": "Cover in Schwarz-Weiß, Farbe beim Hover",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "card_cover_meta",
        "label": "Ohne Bild: Katalognummer und Typ auf dem Cover",
        "default": true
      },
      {
        "type": "select",
        "id": "card_meta",
        "label": "Meta-Zeile",
        "default": "auto",
        "options": [
          {
            "value": "auto",
            "label": "Automatisch (BPM · Key · Genre, sonst Samples · Genre · Typ)"
          },
          {
            "value": "type_count",
            "label": "Samples · Typ"
          },
          {
            "value": "type",
            "label": "Nur Typ"
          }
        ]
      }
    ]
  },
  {
    "name": "Bewegung",
    "settings": [
      {
        "type": "checkbox",
        "id": "scroll_reveal",
        "label": "Bilder und Sektionen beim Scrollen einblenden",
        "info": "Aus = alles ist sofort sichtbar, ruhiger.",
        "default": false
      }
    ]
  },
  {
    "name": "Warenkorb",
    "settings": [
      {
        "type": "select",
        "id": "cart_type",
        "label": "Warenkorb-Typ",
        "default": "drawer",
        "options": [
          {
            "value": "drawer",
            "label": "Seitenleiste"
          },
          {
            "value": "page",
            "label": "Seite"
          }
        ]
      },
      {
        "type": "text",
        "id": "cart_note_text",
        "label": "Hinweis im Warenkorb",
        "default": "Digitaler Download. Der Link kommt direkt nach dem Kauf per Mail."
      }
    ]
  },
  {
    "name": "Social Media",
    "settings": [
      {
        "type": "url",
        "id": "social_tiktok",
        "label": "TikTok"
      },
      {
        "type": "url",
        "id": "social_instagram",
        "label": "Instagram"
      },
      {
        "type": "url",
        "id": "social_youtube",
        "label": "YouTube"
      },
      {
        "type": "url",
        "id": "social_spotify",
        "label": "Spotify"
      }
    ]
  }
]