      { "type": "image_picker", "id": "favicon", "label": "Favicon", "info": "Quadratisch, mind. 64 × 64 px" },
      { "type": "image_picker", "id": "share_image", "label": "Social-Sharing-Bild", "info": "1200 × 630 px" }
    ]
